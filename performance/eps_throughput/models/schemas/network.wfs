// 网络流事件 — 吞吐压测（多事件类型 + 结构化字段）
window conn_events {
    stream_tag = "conn_events"
    time = event_time
    over = 2m
    fields {
        sip: ip
        dip: ip
        dport: digit
        bytes: digit
        bytes_in: digit
        bytes_out: digit
        protocol: chars
        action: chars
        duration: digit
        event_time: time
    }
}

// 登录认证事件 — 第二类事件源
window auth_events {
    stream_tag = "auth_events"
    time = event_time
    over = 2m
    fields {
        source_ip: ip
        user: chars
        result: chars
        dest_ip: ip
        event_time: time
    }
}

// 告警输出
window network_alerts {
    over = 0
    fields {
        sip: ip
        dip: ip
        alert_type: chars
        detail: chars
        request_count: digit
        uid: chars
    }
}
