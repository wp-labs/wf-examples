use "network.wfs"

// 高阈值聚合规则：每个 distinct sip 需要一个实例，阈值 1M 几乎不会触发
// → 实例持续存活为部分匹配，用于观察实例数/内存随输入的变化
//
// match<sip:60s>：实例 TTL = 60s（距最后事件）。
// 输入停止后事件 watermark 冻结，但规则任务的周期 timeout 扫描会把墙钟信用
// （每次 ≤ 1s，随扫描累计）叠加到有效水位 —— idle 实例仍按 TTL 过期释放
// （wp-reactor fix(wf-runtime): scan_timeouts 墙钟信用按扫描累计）。
// 输入恢复（trickle）推进事件 watermark 后，其余旧实例照常被驱逐。

rule instance_growth {
    events {
        c : conn_events
    }
    match<sip:60s> {
        on event { c | count >= 1000000; }
    } -> score(10.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "instance_growth",
        detail = "high threshold keeps instances alive",
        request_count = 1
    )

    limits {
        max_memory = "512MB";
        max_instances = 1000000000;
        on_exceed = throttle;
    }
}
