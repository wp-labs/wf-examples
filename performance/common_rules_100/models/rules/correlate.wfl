// common_rules_100 — 常见 SOC 检测规则（由 scripts/gen_rules.py 生成，勿手改）
// 100 条：auth 15 / scan 15 / c2+exfil 18 / dns 15 / proxy 12 / host+rich 18 / correlate 7

use "network.wfs"
rule corr_scan_conn_dns_query {
    events {
        c : conn_events
        d : dns_events
    }
    match<sip:2m> {
        on event { c | count >= 40; d | count >= 3; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "corr_scan_conn_dns_query",
        detail = "corr_scan_conn_dns_query triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule corr_scan_denied_dns_nx {
    events {
        c : conn_events && c.action == "denied"
        d : dns_events && d.query_type == "NX"
    }
    match<sip:2m> {
        on event { c | count >= 30; d | count >= 6; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "corr_scan_denied_dns_nx",
        detail = "corr_scan_denied_dns_nx triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule corr_longconn_dns_storm {
    events {
        c : conn_events && c.duration >= 300
        d : dns_events
