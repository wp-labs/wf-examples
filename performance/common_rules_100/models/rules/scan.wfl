// common_rules_100 — 常见 SOC 检测规则（由 scripts/gen_rules.py 生成，勿手改）
// 100 条：auth 15 / scan 15 / c2+exfil 18 / dns 15 / proxy 12 / host+rich 18 / correlate 7

use "network.wfs"
rule port_scan_dport_spread {
    events {
        c : conn_events
    }
    match<sip:2m> {
        on event { c.dport | distinct | count >= 50; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "port_scan_dport_spread",
        detail = "port_scan_dport_spread triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

