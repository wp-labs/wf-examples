rule web_sqli_fuzz {
    events {
        p : proxy_events
    }
    match<sip:2m> {
        on event { p && indexof(p.url, "union") >= 0 | count >= 10; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_sqli_fuzz",
        detail = "web_sqli_fuzz triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_bad_ua_crawl {
    events {
        p : proxy_events
    }
    match<sip:2m> {
        on event { p && startswith_any(p.user_agent, "sqlmap", "nikto", "curl") | count >= 8; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_bad_ua_crawl",
        detail = "web_bad_ua_crawl triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_path_traversal {
    events {
        p : proxy_events
    }
    match<sip:2m> {
        on event { p && indexof(p.url, "%2e%2e") >= 0 | count >= 3; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_path_traversal",
        detail = "web_path_traversal triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_upload_large {
    events {
        p : proxy_events && p.method == "POST"
    }
    match<sip:2m> {
        on event { p.bytes | sum >= 500000000; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_upload_large",
        detail = "web_upload_large triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_single_host_focus {
    events {
        p : proxy_events && p.status >= 400
    }
    match<host:2m> {
        on event { p | count >= 40; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_single_host_focus",
        detail = "web_single_host_focus triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

