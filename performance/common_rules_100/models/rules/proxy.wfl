// common_rules_100 — 常见 SOC 检测规则（由 scripts/gen_rules.py 生成，勿手改）
// 100 条：auth 15 / scan 15 / c2+exfil 18 / dns 15 / proxy 12 / host+rich 18 / correlate 7

use "network.wfs"
rule web_brute_login_post {
    events {
        p : proxy_events && p.method == "POST"
    }
    match<sip:2m> {
        on event { p | count >= 30; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_brute_login_post",
        detail = "web_brute_login_post triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_scan_status_5xx {
    events {
        p : proxy_events && p.status >= 500
    }
    match<sip:2m> {
        on event { p | count >= 20; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_scan_status_5xx",
        detail = "web_scan_status_5xx triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_scan_status_404 {
    events {
