    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_rare_method",
        detail = "web_rare_method triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule web_slow_scrape {
    events {
        p : proxy_events
    }
    match<sip:2m> {
        on event <accu>{ p | count >= 80; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "web_slow_scrape",
        detail = "web_slow_scrape triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

