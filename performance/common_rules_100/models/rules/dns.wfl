rule dns_slow_scan_domains {
    events {
        d : dns_events
    }
    match<sip:2m> {
        on event <accu>{ d | count >= 20; }
    } -> score(50.0)
    entity(ip, d.sip)
    yield network_alerts (
        sip = d.sip,
        alert_type = "dns_slow_scan_domains",
        detail = "dns_slow_scan_domains triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
