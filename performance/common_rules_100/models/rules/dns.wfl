// common_rules_100 — 常见 SOC 检测规则（由 scripts/gen_rules.py 生成，勿手改）
// 100 条：auth 15 / scan 15 / c2+exfil 18 / dns 15 / proxy 12 / host+rich 18 / correlate 7

use "network.wfs"
rule dns_dga_long_domain {
    events {
        d : dns_events
    }
    match<sip:2m> {
        on event { d && length(d.domain) >= 25 | count >= 5; }
    } -> score(50.0)
    entity(ip, d.sip)
    yield network_alerts (
        sip = d.sip,
        alert_type = "dns_dga_long_domain",
        detail = "dns_dga_long_domain triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule dns_dga_highfreq_bot {
    events {
        d : dns_events && d.resp_size == 0
    }
    match<sip:2m> {
        on event { d | count >= 20; }
    } -> score(50.0)
    entity(ip, d.sip)
    yield network_alerts (
        sip = d.sip,
