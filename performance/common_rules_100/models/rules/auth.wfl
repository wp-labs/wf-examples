rule auth_bad_agent_fail_5 {
    events {
        a : auth_events
    }
    match<source_ip:2m> {
        on event { a && startswith_any(a.agent, "powershell", "curl", "sqlmap") | count >= 5; }
    } -> score(50.0)
    entity(ip, a.source_ip)
    yield network_alerts (
        sip = a.source_ip,
        alert_type = "auth_bad_agent_fail_5",
        detail = "auth_bad_agent_fail_5 triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

