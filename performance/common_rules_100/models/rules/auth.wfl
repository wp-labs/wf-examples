rule auth_brute_src_users_8 {
    events {
        a : auth_events && a.result == "failed"
    }
    match<source_ip:2m> {
        on event { a.user | distinct | count >= 8; }
    } -> score(50.0)
    entity(ip, a.source_ip)
    yield network_alerts (
        sip = a.source_ip,
        alert_type = "auth_brute_src_users_8",
        detail = "auth_brute_src_users_8 triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

