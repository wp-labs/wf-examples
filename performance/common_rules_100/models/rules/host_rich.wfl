rule rich_string_proto_match {
    events {
        c : conn_events
    }
    match<sip:2m> {
        on event { c && startswith(c.protocol, "tc") && indexof(c.protocol, "p") >= 0 | count >= 8; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "rich_string_proto_match",
        detail = "rich_string_proto_match triggered",
        request_count = 1
    )
