rule host_infected_survey {
    events {
        c : conn_events && c.protocol == "udp"
    }
    match<sip:2m> {
        on event { c.dip | distinct | count >= 30; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "host_infected_survey",
        detail = "host_infected_survey triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule host_sanctioned_geo {
    events {
        c : conn_events
    }
    match<sip:2m> {
        on event { c && startswith_any(c.geo_country, "RU", "KP", "IR") | count >= 3; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "host_sanctioned_geo",
        detail = "host_sanctioned_geo triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

