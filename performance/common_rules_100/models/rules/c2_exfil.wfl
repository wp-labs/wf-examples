// common_rules_100 — 常见 SOC 检测规则（由 scripts/gen_rules.py 生成，勿手改）
// 100 条：auth 15 / scan 15 / c2+exfil 18 / dns 15 / proxy 12 / host+rich 18 / correlate 7

use "network.wfs"
rule c2_beacon_low_freq {
    events {
        c : conn_events && c.duration >= 300
    }
    match<sip:2m> {
        on event { c | count >= 4; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "c2_beacon_low_freq",
        detail = "c2_beacon_low_freq triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule c2_uncommon_port {
    events {
        c : conn_events && c.dport >= 50000
