rule exfil_archive_up {
    events {
        c : conn_events
    }
    match<sip:2m> {
        on event { c && startswith_any(c.app_id, "zip", "tar", "rar", "gz", "7z") | count >= 2; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "exfil_archive_up",
        detail = "exfil_archive_up triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
