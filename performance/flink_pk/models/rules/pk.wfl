use "network.wfs"

rule seq2_sip_0_0 {
    events {
        s1 : conn_events && action == "syn"
        s2 : conn_events && action == "denied"
    }
    match<sip:5m> {
        on event { s1 | count >= 5; s2 | count >= 3; }
    } -> score(85.0)
    entity(ip, s1.sip)
    yield network_alerts (sip = s1.sip, alert_type = "seq2_sip_0_0", detail = "syn then denied", request_count = 1)
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

