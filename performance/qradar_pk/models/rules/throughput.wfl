rule multi_proxy_firewall {
    events {
        p : proxy_events && p.status == 500
        fw : firewall_events && fw.action == "deny"
    }
    match<sip:2m> {
        on event { p | count >= 5; fw | count >= 5; }
    } -> score(50.0)
    entity(ip, p.sip)
    yield network_alerts (
        sip = p.sip,
        alert_type = "multi_proxy_firewall",
        detail = "multi_proxy_firewall triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

rule multi_dns_firewall {
    events {
        d : dns_events
        fw : firewall_events && fw.action == "deny"
    }
    match<sip:2m> {
