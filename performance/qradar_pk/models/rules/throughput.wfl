use "network.wfs"

rule c_sip_3 {
    events {
        c : conn_events
    }
    match<sip:2m> {
        on event { c | count >= 3; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "c_sip_3",
        detail = "c_sip_3 triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

