// perf_diag_case — 单流 schema（最小但覆盖规则墙三类成本：count/guard/distinct）
window evt_events {
    stream_tag = "evt_events"
    time = event_time
    over = 2m
    fields {
        sip: ip
        action: chars
        code: digit
        blocked: bool
        bytes: digit
        event_time: time
    }
}

// 规则 yield 目标（21 条规则统一输出到本窗口，sink 侧 blackhole 丢弃）
window network_alerts {
    over = 0
    fields {
        sip: ip
        alert_type: chars
        detail: chars
        request_count: digit
    }
}
