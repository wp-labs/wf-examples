rule c_sip_5 {
    events {
        c : evt_events
    }
    match<sip:2m> {
        on event { c | count >= 5; }
    } -> score(50.0)
    entity(ip, c.sip)
    yield network_alerts (
        sip = c.sip,
        alert_type = "c_sip_5",
        detail = "c_sip_5 triggered",
        request_count = 1
    )
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}
