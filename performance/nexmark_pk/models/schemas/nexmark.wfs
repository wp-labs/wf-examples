// NEXMark 基准 — Person/Auction/Bid 三事件流（标准事件模型）
// 数据由 scripts/gen_nexmark.py 确定性生成，事件时间覆盖 ~30 分钟。
// ⚠ over=1h：join 目标窗口（person/auction/bid）必须覆盖数据 span 才能
// 保证实体行在 join 时可见——v5 数据 span = count×100µs（10m=1000s、30m=3000s），
// 旧 over=10m(600s) 会时间驱逐早期实体行 → snapshot/asof join miss（Q3 差 50%、
// Q6 差 36%、Q20 差 21%、Q9 差 24% 的根因，2026-08-22 实测）。
window person_events {
    stream_tag = "person_events"
    time = dateTime
    over = 1h
    fields {
        id: digit
        name: chars
        email: chars
        creditCard: chars
        city: chars
        state: chars
        dateTime: time
        extra: chars
    }
}

window auction_events {
    stream_tag = "auction_events"
    time = dateTime
    over = 1h
    fields {
        id: digit
        itemName: chars
        description: chars
        initialBid: digit
        reserve: digit
        dateTime: time
        expires: time
        seller: digit
        category: digit
        extra: chars
    }
}

window bid_events {
    stream_tag = "bid_events"
    time = dateTime
    over = 1h
    fields {
        auction: digit
        bidder: digit
        price: digit
        channel: chars
        channel_id: chars
        url: chars
        dateTime: time
        extra: chars
    }
}

// 告警输出
window nexmark_alerts {
    over = 0
    fields {
        id: digit
        alert_type: chars
        detail: chars
        request_count: digit
    }
}
