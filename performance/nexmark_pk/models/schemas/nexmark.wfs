// NEXMark 基准 — Person/Auction/Bid 三事件流（标准事件模型，10m 窗口）
// 数据由 scripts/gen_nexmark.py 确定性生成，事件时间覆盖 ~30 分钟。
window person_events {
    stream_tag = "person_events"
    time = dateTime
    over = 10m
    fields {
        id: digit
        name: chars
        email: chars
        creditCard: chars
        city: chars
        state: chars
        dateTime: time
        extra: chars
    }
}

window auction_events {
    stream_tag = "auction_events"
    time = dateTime
    over = 10m
    fields {
        id: digit
        itemName: chars
        description: chars
        initialBid: digit
        reserve: digit
        dateTime: time
        expires: time
        seller: digit
        category: digit
        extra: chars
    }
}

window bid_events {
    stream_tag = "bid_events"
    time = dateTime
    over = 10m
    fields {
        auction: digit
        bidder: digit
        price: digit
        channel: chars
        url: chars
        dateTime: time
        extra: chars
    }
}

// 告警输出
window nexmark_alerts {
    over = 0
    fields {
        id: digit
        alert_type: chars
        detail: chars
        request_count: digit
    }
}
