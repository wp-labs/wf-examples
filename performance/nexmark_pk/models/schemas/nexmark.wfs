// NEXMark 基准 — Person/Auction/Bid 三事件流（标准事件模型）
// 数据由 scripts/gen_nexmark.py 确定性生成，事件时间覆盖 ~30 分钟。
//
// over 策略（2026-08-25 评估 gate 落地后重定）：
// - person/auction 窗 over=1h：snapshot join（q3 join person / q6·q20 join
//   auction）的驱动事件可引用**任意老**的实体行 → over 需覆盖数据 span
//   （v5 span = count×100µs：10m=1000s、30m=3000s < 1h ✓）。30M 是正确性
//   量级；100M span 2h46m > 1h 时 snapshot join 的老实体行会被驱逐（性能
//   量级口径接受，q3/q6/q20 已知偏差）。
// - bid 窗 over=15m（2026-08-27 从 30m 调小——q18 100M RSS 30.3→28.0GB，
//   省 2.2GB；再调 5m 无额外收益（窗口驻留仅 0.57GB，非大头）；over 是纯
//   内存参数（评估 gate + D4 pin 已闭环正确性，见下），调小只减内存。
//   唯一把 bid 当 join 目标的
//   deferred join（q4a/q9）。正确性由两层保证：运行期评估 gate（评估前沿 =
//   目标窗 append 位置，目标追平 expiry 才评估，右行年龄 ≈ 0）+ D4 保留 pin
//   闭环到时间驱逐（挂起实例需要 [lo,hi] 内的右行，over 再小也不删）。
//   over 只是内存参数。
//   历史教训（勿回退）：D4 pin 落地前 over=10m/5s/2m 因「deferred 评估由
//   auction watermark 驱动、bid 窗按摄入位置驱逐」的滞后差丢 73~84%（q9）；
//   评估 gate 才是根治，over 不再是预算兵役。
window person_events {
    stream_tag = "person_events"
    time = dateTime
    over = 1h
    fields {
        id: digit
        name: chars
        email: chars
        creditCard: chars
        city: chars
        state: chars
        dateTime: time
        extra: chars
    }
}

window auction_events {
    stream_tag = "auction_events"
    time = dateTime
    over = 1h
    fields {
        id: digit
        itemName: chars
        description: chars
        initialBid: digit
        reserve: digit
        dateTime: time
        expires: time
        seller: digit
        category: digit
        extra: chars
    }
}

window bid_events {
    stream_tag = "bid_events"
    time = dateTime
    over = 15m
    fields {
        auction: digit
        bidder: digit
        price: digit
        channel: chars
        channel_id: chars
        url: chars
        dateTime: time
        extra: chars
    }
}

// 告警输出
window nexmark_alerts {
    over = 0
    fields {
        id: digit
        alert_type: chars
        detail: chars
        request_count: digit
    }
}

// Q4 内层中间窗口：每 auction 生命周期内胜出价（deferred reduce maxrow 在
// a.expires 到期输出一条，时间列 = 到期时刻）。外层 stats 按 category 消费
// 做 avg-of-max（NEXMARK_AUTHORITATIVE_SEMANTICS.md Q4 两层聚合）。
window auction_finals {
    time = dateTime
    over = 1h
    fields {
        id: digit
        category: digit
        final: digit
        dateTime: time
    }
}

// Q13 内层中间窗口：每 bid 一行 + 预计算 mod(auction,10000)（侧输入 join 键）。
// 外层 q13b 按 mod_key 查 side_input 静态表富化（NEXMARK_AUTHORITATIVE_SEMANTICS.md
// Q13 Bounded Side Input Join：ON mod(B.auction, 10000) = S.key）。
window bid_mod {
    time = dateTime
    over = 1h
    fields {
        id: digit
        bidder: digit
        auction: digit
        price: digit
        dateTime: time
        mod_key: digit
    }
}

// Q13 有界侧输入（side_input.txt 静态表：key 0..9999 → value，knowdb CSV 加载）。
// 权威 SQL：JOIN side_input FOR SYSTEM_TIME AS OF B.p_time ON mod(B.auction,10000)=S.key
window<provider> side_input {
    fields {
        key: digit
        value: chars
    }
}
