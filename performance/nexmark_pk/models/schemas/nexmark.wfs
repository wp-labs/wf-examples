// NEXMark 基准 — Person/Auction/Bid 三事件流（标准事件模型）
// 数据由 scripts/gen_nexmark.py 确定性生成，事件时间覆盖 ~30 分钟。
// ⚠ over=1h（2026-08-23 归因确认后维持）：join 目标窗口（person/auction/bid）必须
// 覆盖数据 span 才能保证实体行在 join 时可见——v5 数据 span = count×100µs
// （10m=1000s、30m=3000s），旧 over=10m(600s) 会时间驱逐早期实体行 →
// snapshot/asof join miss（Q3 差 50%、Q6 差 36%、Q20 差 21%、Q9 差 24% 的根因）。
//
// 曾试将 bid over 调小（5s/2m）以降 q13 RSS——q13 的 bid 窗口持全量是 RSS 大头，
// 但 q9（唯一把 bid 当 join 目标的 deferred reduce join）会丢 73~84% 输出：
// q9 的 deferred 评估由 **auction watermark**（慢，2% 事件）驱动，而 bid 窗口驱逐
// 由 **bid watermark**（快）驱动，两者事件时间差 = 摄入-消费积压滞后（30m 数据
// 可达 ~1700s），over < 滞后时评估前 bids 已被驱逐。这是设计文档 D4 悬置项
// （deferred join 规则需在 join 窗口注册保留 pin，按自身 watermark 推进 ack）；
// 落地前 over 保持 1h。q13 RSS 已由死 join 消除（各 1.7M→15.9M EPS）大幅修复。
window person_events {
    stream_tag = "person_events"
    time = dateTime
    over = 1h
    fields {
        id: digit
        name: chars
        email: chars
        creditCard: chars
        city: chars
        state: chars
        dateTime: time
        extra: chars
    }
}

window auction_events {
    stream_tag = "auction_events"
    time = dateTime
    over = 1h
    fields {
        id: digit
        itemName: chars
        description: chars
        initialBid: digit
        reserve: digit
        dateTime: time
        expires: time
        seller: digit
        category: digit
        extra: chars
    }
}

window bid_events {
    stream_tag = "bid_events"
    time = dateTime
    over = 1h
    fields {
        auction: digit
        bidder: digit
        price: digit
        channel: chars
        channel_id: chars
        url: chars
        dateTime: time
        extra: chars
    }
}

// 告警输出
window nexmark_alerts {
    over = 0
    fields {
        id: digit
        alert_type: chars
        detail: chars
        request_count: digit
    }
}

// Q4 内层中间窗口：每 auction 生命周期内胜出价（deferred reduce maxrow 在
// a.expires 到期输出一条，时间列 = 到期时刻）。外层 stats 按 category 消费
// 做 avg-of-max（NEXMARK_AUTHORITATIVE_SEMANTICS.md Q4 两层聚合）。
window auction_finals {
    time = dateTime
    over = 1h
    fields {
        id: digit
        category: digit
        final: digit
        dateTime: time
    }
}
