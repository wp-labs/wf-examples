use "nexmark.wfs"

// Q4 — Average Price for a Category（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q4）
// 权威 SQL（两层聚合）：
//   SELECT Q.category, AVG(Q.final)
//   FROM (SELECT MAX(B.price) AS final, A.category
//         FROM auction A, bid B
//         WHERE A.id = B.auction AND B.dateTime BETWEEN A.dateTime AND A.expires
//         GROUP BY A.id, A.category) Q
//   GROUP BY Q.category;
// —— 内层每 auction 生命周期 [dateTime, expires] 内胜出价 max；外层按 category
// 求 avg（avg-of-max）。
//
// wfusion 表达（双规则链，2026-08-23 落地；G7 probe 实证可编译可运行）：
// - 内层 q4a：`on each a` + deferred `reduce maxrow(price) within
//   [a.dateTime, a.expires] emit at a.expires`（Q9 同款）——auction 挂起、
//   watermark ≥ expires 到期评估出胜出价，yield 到中间窗口 `auction_finals`
//   （id/category/final/dateTime=到期时刻）。
// - 外层 q4b：`stats<1d:fixed> group by (category) { avg(f.final) }` 消费
//   auction_finals（intermediate relay，与 `__wf_pipe_` 管道同机制）——1d 桶在
//   有界 benchmark 下覆盖全流（EOS close_all 收口），每 category 一行 avg。
//
// 语义说明：
// - avg 口径：官方 avg(每 auction 的 max 胜出价)——本双规则链逐层一致
//   （旧 `match<category:10m:fixed>` 直接 avg(窗口内 bid 价) 为度量错，已废）。
// - 输出基数：外层每 category 一行（有界 1d 桶 + EOS 收口），对齐官方无界
//   per-category 输出在 benchmark 下的形态。
// - 验证：内层输出（每 auction 胜出价，10k → 455 条 = q9 同款计数）oracle
//   可对拍；外层 stats 规则 oracle 暂不执行（known-diff 列表），daemon 级
//   串联对拍待 stats oracle 接入。
rule q4a_auction_finals {
    events { a : auction_events }
    on each a -> score(20.0)
    join bid_events reduce maxrow(price) tie(dateTime asc)
        within [a.dateTime, a.expires]
        on a.id == bid_events.auction as winner
        emit at a.expires
    entity(digit, a.id)
    yield auction_finals (
        id = a.id,
        category = a.category,
        final = winner.price,
        dateTime = a.expires
    )
}

rule q4b_category_avg {
    events { f : auction_finals }
    stats<1d:fixed> group by (f.category) {
        f | avg(f.final) as avg_final;
    }
    entity(digit, f.category)
    yield nexmark_alerts (
        id = f.category,
        alert_type = "q4_avg",
        detail = fmt("{}", stat.value(final(avg_final))),
        request_count = 1
    )
    limits { max_memory = "512MB" }
}
