use "nexmark.wfs"

// Q13 — Bounded Side Input Join（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q13）
// 权威 SQL：
//   SELECT B.auction, B.bidder, B.price, B.dateTime, S.`value`
//   FROM (SELECT *, PROCTIME() as p_time FROM bid) B
//   JOIN side_input FOR SYSTEM_TIME AS OF B.p_time AS S
//   ON mod(B.auction, 10000) = S.key;
// —— 每 bid 一行，按 mod(auction,10000) 查有界侧输入静态表（key 0..9999）
//    富化 value 输出（流 enrichment）。
//
// wfusion 表达（双规则链，q4 同款 pipe 模式）：
// - 内层 q13a：`on each b` yield 到中间窗口 `bid_mod`——每 bid 一行，预计算
//   mod_key = b.auction % 10000（join 条件只支持字段引用，mod 表达式先物化）。
// - 外层 q13b：`on each m` + `join side_input snapshot on m.mod_key ==
//   side_input.key`——snapshot join 查 provider 静态表（knowdb CSV 加载），
//   miss 保留事件不富化（snapshot 外联语义），命中富化 value。
// 输出基数 = 每 bid 一行（对齐权威；join miss 的 bid 富化 value 为空字符串）。
//
// 注：join-then-key 的 key 必须落在右窗键字段；本链用 provider 静态表
// （`window<provider> side_input`），daemon 从 knowdb.toml 加载
// data/side_input/side_input.csv（key 0..9999）。
rule q13a_bid_mod {
    events { b : bid_events }
    on each b -> score(10.0)
    entity(digit, b.bidder)
    yield bid_mod (
        id = b.bidder,
        bidder = b.bidder,
        auction = b.auction,
        price = b.price,
        dateTime = b.dateTime,
        mod_key = b.auction % 10000
    )
}

rule q13b_side_input_join {
    events { m : bid_mod }
    on each m -> score(10.0)
    join side_input snapshot on m.mod_key == side_input.key
    entity(digit, m.bidder)
    yield nexmark_alerts (
        id = m.bidder,
        alert_type = "q13_sidejoin",
        detail = fmt("{}", side_input.value),
        request_count = 1
    )
}

test q13a_mod_key for q13a_bid_mod {
  input {
    row(b, auction = 12345, bidder = 5, price = 100, channel = "G", url = "u");
  }
  // mod(12345, 10000) = 2345 → 中间窗口 mod_key 字段
  expect { hits == 1; }
}

test q13b_hit for q13b_side_input_join {
  input {
    row(m, id = 5, auction = 2345, price = 100, dateTime = 0, mod_key = 2345);
  }
  expect { hits == 1; hit[0].entity_id == "5"; }
}

test q13b_miss_keeps_event for q13b_side_input_join {
  input {
    row(m, id = 7, auction = 1, price = 100, dateTime = 0, mod_key = 99999);
  }
  // side_input 无 key=99999 → snapshot miss 保留事件（不富化）
  expect { hits == 1; hit[0].entity_id == "7"; }
}
