use "nexmark.wfs"

// Q13 — Bounded Side Input Join（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q13，扩展）
// 权威 SQL：bid ⋈ 文件侧输入 side_input FOR SYSTEM_TIME AS OF B.p_time
//   ON mod(B.auction, 10000) = S.key（有界侧输入 enrichment）。
//
// wfusion 表达：bid ⋈ person 快照 join（`b.bidder == person_events.id`）——把
// person 表作为（准静态）侧输入，每条 bid 快照查找 bidder → person。
// ⚠ 近似：键不同（权威 mod(auction,10000) 查文件 side_input；本地 bidder 查
// person 窗口），但「流 + 有界侧输入 enrichment」形状对齐（person 流近静态 2%，
// 侧输入近似成立）。
rule q13_bid_person_join {
    events { b : bid_events }
    match<bidder:10m> {
        on event { b | count >= 1; }
    } -> score(10.0)
    join person_events snapshot on b.bidder == person_events.id
    entity(digit, b.bidder)
    yield nexmark_alerts (id = b.bidder, alert_type = "q13_sidejoin", detail = "bid joined person", request_count = 1)
    limits { max_memory = "512MB" }
}

test q13_hit for q13_bid_person_join {
  input {
    row(b, auction = 1, bidder = 5, price = 100, channel = "G", url = "u");
  }
  expect { hits == 1; hit[0].entity_id == "5"; }
}
