use "nexmark.wfs"

// Q18 — Find last bid（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q18，扩展）
// 权威 SQL：
//   SELECT * FROM (SELECT *, ROW_NUMBER() OVER
//     (PARTITION BY bidder, auction ORDER BY dateTime DESC) AS rank_number FROM bid)
//   WHERE rank_number <= 1;
// —— 每 (bidder, auction) 取最后一条 bid（按 dateTime 降序 dedup）。
//
// wfusion 映射：`match<bidder,auction:30m:fixed>`（多键窗口）+ `and close` count，
// 每 (bidder,auction) 收口输出一条 → **输出基数对齐**（每键一条 = 官方 dedup 结果数）。
// ⚠ 近似：官方带出「最后一条 bid」的字段值（price/channel/url/...）；wfl 无 last-value
// measure，本地输出键（auction/bidder）与计数，值语义为「窗口内聚合」而非「最后一条」。
rule q18_last_bid {
    events { b : bid_events }
    match<bidder,auction:30m:fixed> {
        on event { b | count >= 1; }
        and close { n: b | count >= 1; }
    } -> score(15.0)
    entity(digit, b.auction)
    yield nexmark_alerts (
        id = b.auction,
        alert_type = "q18_last",
        detail = fmt("bidder {}", b.bidder),
        request_count = 1
    )
    limits { max_memory = "16GB" }
}

test q18_pair for q18_last_bid {
  input {
    row(b, auction = 1, bidder = 5, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 5, price = 200, channel = "G", url = "u");
    tick(31m);
  }
  // 同一 (bidder,auction) 对 → 收口 1 条（官方 dedup 也是 1 条）
  expect { hits == 1; hit[0].entity_id == "1"; }
}

test q18_two_pairs for q18_last_bid {
  input {
    row(b, auction = 1, bidder = 5, price = 100, channel = "G", url = "u");
    row(b, auction = 2, bidder = 5, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 6, price = 100, channel = "G", url = "u");
    tick(31m);
  }
  // 3 个 (bidder,auction) 对 → 3 条
  expect { hits == 3; }
}
