use "nexmark.wfs"

// Q18 — Find last bid（★标准形态：stats last 度量，bench.sh 默认加载；
// ★唯一语义正确版——CEP 版只输出键+计数带不出「最后一条 bid 字段值」（官方 dedup 语义），
// 已改名 q18-verify.wfl 作基数对拍）
// 权威 SQL:
//   SELECT * FROM (SELECT *, ROW_NUMBER() OVER
//     (PARTITION BY bidder, auction ORDER BY dateTime DESC) AS rank_number FROM bid)
//   WHERE rank_number <= 1;
// —— 每 (bidder, auction) 取最后一条 bid 的字段。
//
// stats 形态: `stats<1d:fixed> group by (b.bidder, b.auction)` + 4 个 last 度量
// （price/channel/url/dateTime）; 每个 last 度量保留最近合格行的整行字段, close 时
// 经 field_values 注入 yield 的 `b.*`（Q18 输出 = 最后一条 bid 的字段值）。
// 1d 固定桶 = 有界 benchmark 下覆盖全流（EOS close_all 收口）→ 每键 1 行，对齐
// 权威 ROW_NUMBER dedup 基数；30m 桶会把 >30m 数据切成多桶（每键多行，旧版偏）。
// 注意: last 度量 label 不得与 yield 读的字段名撞名（label 会覆盖同名字段）。
rule q18_last_bid_stats {
    events { b : bid_events }
    stats<1d:fixed> group by (b.bidder, b.auction) {
        b | last(b.price) as last_price;
        b | last(b.channel) as last_channel;
        b | last(b.url) as last_url;
        b | last(b.dateTime) as last_dateTime;
    }
    entity(digit, b.auction)
    yield nexmark_alerts (
        id = b.auction,
        alert_type = "q18_last_stats",
        detail = fmt("{} {} {} {} {}", b.bidder, b.price, b.channel, b.url, b.dateTime),
        request_count = 1
    )
    limits {
        // max_memory = 规则**总**驻留上限（2026-08-27 起, 非旧的每分片）——
        // 10 分片共享 10GB。30M 状态 8.4GB < 10GB 全驻留（EPS 不塌）;
        // 100M 状态 19.5GB → 9.5GB 落盘 spill → RSS ≈ 19GB（目标 ≤20GB）。
        max_memory = "10GB"
        spill = "redb"
        // 规则级总落盘上限（2026-08-27 起）：同规则全部分片共享一个计数——
        // 用户配的是规则总量（不是旧的 8GB/片 × 10 = 80GB）。**内存+落盘必须
        // ≥ 状态总量**: 100M 全量 2937 万键 × ~960B = 28.2GB, 内存 10GB + 落盘
        // 20GB = 30GB（留 1.8GB 余量）; 低于需求会拒收兜底 → 静默丢键
        // （bench [clean] 不覆盖, 需对拍 EMIT 2937 万）。
        max_spill_bytes = "20GB"
    }
}
