use "nexmark.wfs"

// Q9 — Winning Bids（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q9，扩展）
// 权威 SQL：
//   SELECT A.*, B.auction, B.bidder, B.price, ... FROM (
//     SELECT A.*, ..., ROW_NUMBER() OVER (PARTITION BY A.id ORDER BY B.price DESC,
//            B.dateTime ASC) AS rownum
//     FROM auction A, bid B
//     WHERE A.id = B.auction AND B.dateTime BETWEEN A.dateTime AND A.expires)
//   WHERE rownum <= 1
// —— 纯 SQL（Flink planner 编译成时间窗口 join + TopN 去重）：每 auction 生命周期
// [dateTime, expires] 内取价格最高（平手取最早）的 bid 为胜者，恰输出一条。
//
// wfusion 能力面（fixed 窗口 close 聚合）：bid 驱动，每 auction 固定 10m 窗口
// 收口时取**窗口内最高出价**（max measure）作为胜者，EMIT 一条。
//
// ⚠ 近似：固定桶近似 auction 生命周期（计数口径不同：权威每 auction 恰一条，
// 本地每 auction×桶一条）；平手（同价）取最早未定义（权威 ORDER BY dateTime ASC）；
// fixed+close 尾部收口非确定（见 verify known）。
rule q9_winning_bid {
    events { b : bid_events }
    match<auction:10m:fixed> {
        on event { b | count >= 1; }
        and close { w: b.price | max >= 10; }
    } -> score(30.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q9_win", detail = "winning bid", request_count = 1)
    limits { max_memory = "512MB" }
}

test q9_winning_bid_hit for q9_winning_bid {
  input {
    row(b, auction = 5, bidder = 1, price = 100, channel = "G", url = "u");
    tick(11m);
  }
  expect { hits == 1; hit[0].entity_id == "5"; }
}

// AND 模式（on event + and close）：on event 满足后仅标记，输出发生在 close。
// 测试结束 EOS flush 也会触发 close 收口，故「有 bid 的实例」必然输出一条；
// 不存在 no-hit 情形（close 阈值 max>=10 为无条件兑底）。旧 no-hit 测试
// 期望 hits==0 与 AND 语义矛盾（EOS flush 也会 close 输出），已删除。
