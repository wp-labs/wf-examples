use "nexmark.wfs"

// Q17 — Auction Statistics Report（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q17，扩展）
// 权威 SQL：
//   SELECT auction, DATE_FORMAT(dateTime,'yyyy-MM-dd') AS day,
//          count(*), count(*) FILTER (3 价格档), min/max/avg/sum(price)
//   FROM bid GROUP BY auction, day;
// —— 按 auction/天分组输出 bid 总数、三价格档计数与价格 min/max/avg/sum。
//   30m 数据恰 1 天 → GROUP BY auction 退化为每 auction 一行。
//
// wfusion 映射：`match<auction:30m:fixed>`（键 = 事件字段 auction，1.8M 实例）+ `and close`
// 8 个 measure（4 count 分档 + min/max/avg/sum），每 auction 收口一行。
// 输出基数 = 有 bid 的 auction 数（对齐官方每 (auction,day) 一行）。
rule q17_auction_stats {
    events { b : bid_events }
    match<auction:30m:fixed> {
        on event { b | count >= 1; }
        and close {
            total: b | count >= 1;
            r1: b && b.price < 10000 | count >= 1;
            r2: b && b.price >= 10000 && b.price < 1000000 | count >= 1;
            r3: b && b.price >= 1000000 | count >= 1;
            minp: b.price | min >= 1;
            maxp: b.price | max >= 1;
            avgp: b.price | avg >= 1;
            sump: b.price | sum >= 1;
        }
    } -> score(20.0)
    entity(digit, b.auction)
    yield nexmark_alerts (
        id = b.auction,
        alert_type = "q17_stats",
        detail = fmt("{} {} {} {} {} {} {} {}",
            stat.value(final(total)), stat.value(final(r1)), stat.value(final(r2)), stat.value(final(r3)),
            stat.value(final(minp)), stat.value(final(maxp)), stat.value(final(avgp)), stat.value(final(sump))),
        request_count = 1
    )
    limits { max_memory = "16GB" }
}

test q17_stats for q17_auction_stats {
  input {
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 2, price = 50000, channel = "G", url = "u");
    row(b, auction = 1, bidder = 3, price = 2000000, channel = "G", url = "u");
    tick(31m);
  }
  // 1 桶收口：total=3, r1=1, r2=1, r3=1, min=100, max=2000000, avg≈683366.67, sum=2050100
  expect {
    hits == 1;
    hit[0].entity_id == "1";
  }
}
// 注：AND 模式（on event + and close）下「有 bid 的 auction」必然在窗口收口/EOS
// flush 时输出一条；不存在 no-hit 情形，故不设 no-hit 测试（q9 同款教训）。
