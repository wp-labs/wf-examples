use "nexmark.wfs"

// Q6 — Average Selling Price by Seller（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q6）
// 权威 SQL：ROW_NUMBER() OVER (PARTITION BY A.id, A.seller ORDER BY B.price DESC) 取每
//   auction 胜出价，再 AVG(...) OVER (PARTITION BY seller ORDER BY dateTime
//   ROWS BETWEEN 10 PRECEDING AND CURRENT ROW)——每 seller 最近 10 笔成交的
//   胜出价均值（官方注释：OVER WINDOW 尚不支持 retractions，SQL 未落地）。
//
// wfusion 能力面（join 字段作窗口键）：`match<seller:10m>` 的键 `seller` 不在
// 驱动事件（bid）上，而是 auction 的 join 侧字段——引擎先 snapshot join
// （b.auction == auction_events.id）拿到 seller，再按该键分组（join-then-key）。
// 每 seller 的滑动 10m 窗口内 avg(b.price) >= 200 时 EMIT。
//
// ⚠ 近似：聚合面（全部 bid 价均值 vs 胜出价均值）、窗口形状（10m 滑动 vs 最近
// 10 笔成交）不同；仅「按 seller 分组求均值」对齐。
rule q6_avg_price_by_seller {
    events { b : bid_events }
    match<seller:10m> {
        on event { b.price | avg >= 200; }
    } -> score(20.0)
    join auction_events snapshot on b.auction == auction_events.id
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q6_avg200", detail = "avg bid >= 200", request_count = 1)
    limits { max_memory = "512MB" }
}
