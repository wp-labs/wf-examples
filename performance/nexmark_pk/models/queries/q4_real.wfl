use "nexmark.wfs"

// 真 Q4：bid ⋈ auction join（bid 驱动，92M bids 进管道）
// 每条 bid 用 snapshot join 查 auction 窗口拿 category（yield 引用），
// 按 bid.auction 窗口 count 聚合。工作负载 = Flink Q4（处理 92M bid + join 查表）。
rule q4_real_avg_100 {
    events { b : bid_events }
    match<auction:10m> {
        on event { b | count >= 1; }
    } -> score(10.0)
    join auction_events snapshot on b.auction == auction_events.id
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q4_real_100", detail = "bid joined", request_count = 1)
    limits { max_memory = "512MB" }
}
