use "nexmark.wfs"
rule q5_bidcount_10 {
    events { b : bid_events }
    match<auction:10m> {
        on event { b | count >= 10; }
    } -> score(20.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q5_count10", detail = ">=10 bids", request_count = 1)
    limits { max_memory = "512MB" }
}


rule q5_bidcount_50 {
    events { b : bid_events }
    match<auction:10m> {
        on event { b | count >= 50; }
    } -> score(20.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q5_count50", detail = ">=50 bids", request_count = 1)
    limits { max_memory = "512MB" }
}


rule q5_bidcount_100 {
    events { b : bid_events }
    match<auction:10m> {
        on event { b | count >= 100; }
    } -> score(20.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q5_count100", detail = ">=100 bids", request_count = 1)
    limits { max_memory = "512MB" }
}

// ---- Q7 每 auction 10m 窗口最高出价（滑动窗口 MAX） ----

test q5_ten_hits for q5_bidcount_10 {
  input {
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
  }
  expect { hits == 1; }
}
