use "nexmark.wfs"

// 对齐 Flink Q2：SELECT auction FROM bid WHERE MOD(auction,123)=0（选中 ~0.81% bids）
rule q2_mod_123 {
    events { b : bid_events && b.auction % 123 == 0 }
    match<auction:10m> {
        on event { b | count >= 1; }
    } -> score(5.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q2_mod123", detail = "auction % 123 == 0", request_count = 1)
    limits { max_memory = "512MB" }
}
