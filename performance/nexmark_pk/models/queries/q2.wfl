use "nexmark.wfs"

// Q2 — Selection（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q2）
// 权威 SQL：SELECT auction, price FROM bid WHERE MOD(auction, 123) = 0;
// —— 每满足 MOD(auction,123)=0 的 bid 输出一行（per-bid，选中 ~0.81%）。
//
// wfusion 表达：`on each` + bind filter 下推（与 Flink WHERE 同款，下游只见
// 过滤后子集）。无状态路径，每选中 bid 输出一条。
rule q2_mod_123 {
    events { b : bid_events && b.auction % 123 == 0 }
    on each b -> score(5.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q2_mod123", detail = "auction % 123 == 0", request_count = 1)
}

test q2_mod123_hit for q2_mod_123 {
    input {
        row(b, auction = 123, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1000);
    }
    expect {
        hits == 1;
        hit[0].entity_id == "123";
        hit[0].score == 5.0;
    }
}

test q2_mod123_no_hit for q2_mod_123 {
    input {
        row(b, auction = 124, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1000);
        row(b, auction = 122, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1001);
    }
    expect {
        hits == 0;
    }
}

test q2_mod123_multiple_hits for q2_mod_123 {
    input {
        row(b, auction = 123, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1000);
        row(b, auction = 246, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1001);
        row(b, auction = 369, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1002);
        row(b, auction = 124, bidder = 1, price = 100, channel = "Google", url = "u", dateTime = 1003);
    }
    expect {
        hits == 3;
    }
}
