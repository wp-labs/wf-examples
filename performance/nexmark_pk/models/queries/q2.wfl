use "nexmark.wfs"
rule q2_filter_auction_7 {
    events { b : bid_events && b.auction == 7 }
    match<auction:10m> {
        on event { b | count >= 1; }
    } -> score(5.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q2_auction7", detail = "auction 7 bids", request_count = 1)
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}


rule q2_filter_auction_1007 {
    events { b : bid_events && b.auction == 1007 }
    match<auction:10m> {
        on event { b | count >= 1; }
    } -> score(5.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q2_auction1007", detail = "auction 1007 bids", request_count = 1)
    limits { max_memory = "512MB"; max_instances = 100000; on_exceed = throttle; }
}

