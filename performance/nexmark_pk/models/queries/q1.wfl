use "nexmark.wfs"

// Q1 — Currency conversion（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q1）
// 权威 SQL：SELECT auction, bidder, 0.908 * price AS price, dateTime, extra FROM bid;
// —— 每 bid 输出一行，价格美元→欧元换算（0.908）。无状态纯投影。
//
// wfusion 表达：`on each`（每 bid 一行，无实例表无状态机）。换算表达式放
// score（`score(0.908 * b.price)`）——每事件真实计算 0.908×price；不放入
// detail 字符串化（fmt 曾致 EPS 减半 + RSS 14GB，是本地特有负担，Flink 输出
// DECIMAL 到 blackhole 不字符串化）。
rule q1_bid_passthrough {
    events { b : bid_events }
    on each b -> score(0.908 * b.price)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q1_passthrough", detail = "bid", request_count = 1)
}

test q1_passthrough for q1_bid_passthrough {
    input {
        row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
        row(b, auction = 2, bidder = 2, price = 200, channel = "G", url = "u");
    }
    // score 是 q1 **唯一的语义决定**（权威 SQL 的 0.908 换算；换算放 score 而不放 detail 是本地口径取舍）。
    // 它恰好是 L3 引擎级对拍**看不见**的：两侧读同一份规则，0.908 改成 0.9 照样全绿 —— 只能在这里钉住。
    expect {
        hits == 2;
        hit[0].entity_id == "1";
        hit[1].entity_id == "2";
        hit[0].score == 90.8;    // 0.908 × 100（未触顶）
        hit[1].score == 100.0;   // 0.908 × 200 = 181.6 → 被引擎的 score 语义 clamp(0,100) 截到 100
    }
}
