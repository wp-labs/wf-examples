use "nexmark.wfs"

// Q19 — Auction TOP-10 Price（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q19，扩展）
// 权威 SQL：
//   SELECT * FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY auction ORDER BY price DESC)
//                  AS rank_number FROM bid) WHERE rank_number <= 10;
// —— 每 auction 价格最高的 10 个 bid（per-key TOP-N）。
//
// ⚠ 未实现（引擎能力待补）：wfusion 的 conv top-N 是「收口批全局 top-N」，无
// per-key 分组（每 auction 各自 top-10 需要 conv 按键分组或 ROW_NUMBER 算子）。
// 下方规则保留为**能力面测试**（cap：有序序列 on event seq 连续 2 bid），
// 与权威 q19 语义无关；权威语义待引擎支持 per-key TopN 后重写。
rule q19_seq_two_bids {
    events { b : bid_events }
    match<auction:10m> {
        on event seq {
            has b;
            has b within 60s;
        }
    } -> score(20.0)
    entity(digit, b.auction)
    yield nexmark_alerts (id = b.auction, alert_type = "q19_seq2", detail = "2 bids in sequence", request_count = 1)
    limits { max_memory = "8GB" }
}

test q19_hit for q19_seq_two_bids {
  input {
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
  }
  expect { hits == 1; }
}
test q19_too_late for q19_seq_two_bids {
  input {
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
    tick(61s);
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u");
  }
  expect { hits == 0; }
}
