use "nexmark.wfs"

// Q19 — Auction TOP-10 Price（stats 声明式版本, 对齐 NEXMARK_AUTHORITATIVE_SEMANTICS.md Q19）
// 权威 SQL:
//   SELECT * FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY auction ORDER BY price DESC)
//                  AS rank_number FROM bid) WHERE rank_number <= 10;
// —— 每 auction 价格最高的 10 个 bid。
//
// ⚠ 语义注记（2026-08-25）: 真实业务是**滚动 top-N**（实时引擎的常见形态）——
// 窗口 = 业务参数, 不是权威全局 top-10 的近似。原 `30m:fixed` 在 replay 数据
// （~30min 跨距）下等于全局; 改为 `10m:fixed` 后为「每 10m 窗口每 auction
// top-10」——内存峰值 = 窗口时长 × 速率 × 每键 top-10 行（有界, 每窗重置）。
//
// stats 形态: `stats<10m:fixed> group by (b.auction)` + `top(10, b.price)` ——
// per-key 有界 top-N; close 时每个条目一条 alert（rank 序: price DESC, 同价先到者
// 在前——确定性 tie-break）, 条目行字段经 field_values 注入 yield 的 `b.*`。
rule q19_auction_top10_stats {
    events { b : bid_events }
    stats<10m:fixed> group by (b.auction) {
        b | top(10, b.price) as top_price;
    }
    entity(digit, b.auction)
    yield nexmark_alerts (
        id = b.auction,
        alert_type = "q19_top10_stats",
        detail = fmt("{} {}", b.bidder, b.price),
        request_count = 1
    )
    limits {
        // spill 验证结论（2026-08-27, docs/issues/spill-scope-expansion.md P0）:
        // 100M 状态仅 ~0.5GB/窗(10m:fixed, 每窗 ~36 万 auction), RSS 7.3GB 达标——
        // **无需 spill**。验证发现 2 个问题(见 issue 文档):
        // ① 配 spill 但零驱逐 → store 空转 churn RSS +6GB(170 次 create/cleanup)
        //    ——已修复: store 惰性创建(首次驱逐才建, 修复后复测 RSS 7.36GB);
        // ② 预算<状态时驱逐滞后 → 拒收丢键且 [clean] 盲区不报(EMIT 对拍 44,089,718
        //    vs 基线 44,145,610 差 55,892)。回归无 spill 基线。
        max_memory = "16GB"
    }
}
