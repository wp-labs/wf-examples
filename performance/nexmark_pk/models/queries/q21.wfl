use "nexmark.wfs"

// Q21 — Add channel id（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q21，扩展）
// 权威 SQL：
//   SELECT auction, bidder, price, channel,
//          CASE
//            WHEN lower(channel) = 'apple'  THEN '0'
//            WHEN lower(channel) = 'google' THEN '1'
//            WHEN lower(channel) = 'facebook' THEN '2'
//            WHEN lower(channel) = 'baidu'  THEN '3'
//            ELSE REGEXP_EXTRACT(url, '(&|^)channel_id=([^&]*)', 2)
//          END AS channel_id
//   FROM bid
//   WHERE REGEXP_EXTRACT(url, '(&|^)channel_id=([^&]*)', 2) IS NOT NULL
//         OR lower(channel) IN ('apple','google','facebook','baidu');
// —— 每命中 bid 输出 channel_id（热通道按名映射 0/1/2/3，cold 从 url 提取
// channel_id=N）。官方 cold 通道 10% 概率无 channel_id 参数（BidGenerator
// createChannelUrlCache 的 `random.nextInt(10) > 0` 90% 追加）→ WHERE 过滤
// 掉这些行：输出量 = 热 50% + cold 有参 90%×50% = **95%** 的 bid（非全量）。
//
// 2026-08-22 语义修正：数据侧 wfgen 已模拟官方 90% 追加（无 channel_id 的
// cold bid 输出 channel_id = ""），bind filter `channel_id != ""` 等价官方
// WHERE（热通道字段恒非空 "0".."3"，cold 有参非空，cold 无参为空串被滤掉）。
// wfusion 能力面映射：channel_id 为**数据生成时已知**的值（wfgen 按官方 CASE
// 映射与 url channel_id 计算后随 bid 输出，见 NEXMARK_CONFORMANCE.md），规则侧
// 过滤 + 投影读取；sink 为 nexmark_alerts 四列，channel_id 放 detail。
//
// 工作负载：27.6M×95% ≈ 26.2M bid 过滤 + 无状态投影——对齐 Flink Q21 的
// 过滤+投影面。
rule q21_channel_id {
    events { b : bid_events && b.channel_id != "" }
    on each b -> score(10.0)
    entity(digit, b.auction)
    yield nexmark_alerts (
        id = b.auction,
        alert_type = "q21_cid",
        detail = b.channel_id,
        request_count = 1
    )
    limits { max_memory = "512MB" }
}

test q21_hot_channel for q21_channel_id {
  input {
    row(b, auction = 1, bidder = 1, price = 100, channel = "Google", channel_id = "1",
        url = "https://www.nexmark.com/aaaaa/bbbbb/ccccc/item.htm?query=1");
  }
  expect {
    hits == 1;
    hit[0].field("detail") == "1";
  }
}

test q21_cold_channel for q21_channel_id {
  input {
    row(b, auction = 2, bidder = 2, price = 200, channel = "channel-42", channel_id = "42",
        url = "https://www.nexmark.com/aaaaa/bbbbb/ccccc/item.htm?query=1&channel_id=42");
  }
  expect {
    hits == 1;
    hit[0].field("detail") == "42";
  }
}

test q21_cold_no_channel_id_filtered for q21_channel_id {
  // 官方 cold 通道 10% 无 channel_id（url 无参数）→ WHERE 过滤，不输出。
  input {
    row(b, auction = 3, bidder = 3, price = 300, channel = "channel-7", channel_id = "",
        url = "https://www.nexmark.com/aaaaa/bbbbb/ccccc/item.htm?query=1");
    row(b, auction = 4, bidder = 4, price = 400, channel = "channel-8", channel_id = "8",
        url = "https://www.nexmark.com/aaaaa/bbbbb/ccccc/item.htm?query=1&channel_id=8");
  }
  expect {
    hits == 1;
    hit[0].entity_id == "4";
  }
}
