use "nexmark.wfs"

// Q14 — Calculation（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q14，扩展）
// 权威 SQL：
//   SELECT auction, bidder, 0.908*price AS price,
//          CASE WHEN HOUR(dateTime) >= 8 AND HOUR(dateTime) <= 18 THEN 'dayTime'
//               WHEN HOUR(dateTime) <= 6 OR HOUR(dateTime) >= 20 THEN 'nightTime'
//               ELSE 'otherTime' END AS bidTimeType,
//          extra, count_char(extra, 'c') AS c_counts
//   FROM bid WHERE 0.908*price > 1000000 AND 0.908*price < 50000000;
// —— 每满足价格区间的 bid 输出一行（货币换算 + 时间分型 CASE + UDF）。
//
// wfusion 映射（on each 每行输出，2026-08-21）：
// - bind filter 下推价格区间（0.908*price ∈ (1e6, 5e7)）；
// - `strftime(b.dateTime, "%H")` 取小时（UTC 数据轴 00:xx → 恒 nightTime，
//   与官方 CASE 语义一致地按小时分型，官方时间轴同源）；
// - `count_char(extra, 'c')` = Flink q14 UDF 同义（wfl 新增函数）。
// 输出基数 = 满足价格区间的 bid 数（对齐官方每行输出）。
rule q14_calculation {
    events { b : bid_events && 0.908 * b.price > 1000000 && 0.908 * b.price < 50000000 }
    on each b -> score(5.0)
    entity(digit, b.auction)
    yield nexmark_alerts (
        id = b.auction,
        alert_type = "q14_calc",
        detail = fmt("{} c={}",
            if strftime(b.dateTime, "%H") in ("00", "01", "02", "03", "04", "05", "06",
                                                "20", "21", "22", "23")
                then "nightTime"
            else if strftime(b.dateTime, "%H") in ("08", "09", "10", "11", "12", "13",
                                                     "14", "15", "16", "17", "18")
                then "dayTime"
            else "otherTime",
            count_char(b.extra, "c")),
        request_count = 1
    )
}

test q14_price_hit for q14_calculation {
  input {
    row(b, auction = 1, bidder = 1, price = 5000000, channel = "G", url = "u", extra = "abaccc");
  }
  expect { hits == 1; hit[0].entity_id == "1"; }
}

test q14_price_below for q14_calculation {
  input {
    row(b, auction = 1, bidder = 1, price = 100, channel = "G", url = "u", extra = "");
  }
  expect { hits == 0; }
}

test q14_count_char for q14_calculation {
  input {
    row(b, auction = 2, bidder = 2, price = 5000000, channel = "G", url = "u", extra = "abaccc", dateTime = 0);
  }
  expect {
    hits == 1;
    hit[0].field("detail") == "nightTime c=3";
  }
}
