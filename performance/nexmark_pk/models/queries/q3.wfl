use "nexmark.wfs"

// Q3 — Local Item Suggestion（权威语义：NEXMARK_AUTHORITATIVE_SEMANTICS.md Q3）
// 权威 SQL：
//   SELECT P.name, P.city, P.state, A.id
//   FROM auction A INNER JOIN person P ON A.seller = P.id
//   WHERE A.category = 10 AND (P.state = 'OR' OR P.state = 'ID' OR P.state = 'CA');
// —— 谁在 OR/ID/CA 州、category=10 下卖东西（增量 join + 过滤）。
//
// wfusion 表达（2026-08-21 补齐州过滤，用 join 后 where）：
// - `A.category = 10`：bind filter 下推（只让 1/5 category=10 的 auction 驱动）；
// - `A.seller = P.id`：auction 驱动 + person 窗口 snapshot join（NEXMark 数据
//   seller 必存在 → join 必命中，富化 P.name/city/state）；
// - `where person_events.state in ("OR","ID","CA")`：**join 后过滤**（新语法，
//   在全部 join 富化后、alert 构建前求值；false/None 抑制输出，对齐 INNER
//   JOIN 丢行——join miss 时 state 缺失也抑制）。
// 输出 = 满足 category=10 ∧ 卖家州∈{OR,ID,CA} 的 auction 数（对齐权威）。
//
// 注：inline test 无法断言本规则（harness 无 WindowLookup，join 全 miss →
// where 全抑制，hits==0 会假通过）——由引擎级 where 测试 + oracle/引擎
// 对拍验证。
rule q3_auction_seller {
    events { a : auction_events && a.category == 10 }
    match<id:10m> {
        on event { a | count >= 1; }
    } -> score(1.0)
    join person_events snapshot on a.seller == person_events.id
    where person_events.state in ("OR", "ID", "CA")
    entity(digit, a.id)
    yield nexmark_alerts (id = a.id, alert_type = "q3", detail = a.seller, request_count = 1)
    limits { max_memory = "512MB" }
}
