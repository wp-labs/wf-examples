use "nexmark.wfs"

// Q8：监控新用户——person 流的**会话窗口**（对齐 Flink Q8「Monitor New Users」）。
//
// 每个 person id 按 60s 间隙聚合为会话；`on event { count >= 1 }` 在会话内首个 person
// 事件触发（非 accu，fire 后 reset）。测试 wfusion 的 **session 窗口**（WindowSpec::Session）
// + person 流状态机路径。
rule q8_monitor_new_user {
    events { p : person_events }
    match<id:session(60s)> {
        on event { p | count >= 1; }
    } -> score(10.0)
    entity(digit, p.id)
    yield nexmark_alerts (id = p.id, alert_type = "q8_new_user", detail = "new user session", request_count = 1)
    limits { max_memory = "512MB" }
}
