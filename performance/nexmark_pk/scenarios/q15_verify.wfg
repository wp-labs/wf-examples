// q15（Bidding Statistics Report）—— WFL 规则验证语料
//
// 规则：models/queries/q15.wfl · `q15_bidding_stats`
//   权威 SQL：SELECT count(*), count(*) FILTER (3 个价格档),
//             count(distinct bidder)…, count(distinct auction)…  （12 列）FROM bid GROUP BY day;
//   WFL：`stats<1d:fixed>`（**空键**固定窗 = UTC 日历天，列式归并执行器）+ 12 度量；
//        entity = **常量** `entity(digit, 1)`；yield 用 `stat.value(final(<label>))` 读度量终值。
//
// ── 判定量是什么 ──────────────────────────────────────────────────────────────
// 判定量 = **空键全局桶在 1d 收口时是否产出那唯一的一行**。空键 ⇒ 桶数恒为 1
// （任何进桶的 bid 只改 12 个度量值、不改输出行数）⇒ 引擎侧输出行数恒为 1。
// L3 的分组键 = (rule, entity_type, entity_id, origin)：
//   · entity_id = 规则 `entity(...)` 表达式的值 = 常量 `1`（**不是**桶键 Debug `Empty`）；
//   · origin = `close:timeout`（stats 收口 = `CloseReason::Timeout`，不是 CEP 的 `close`）；
//   · fired_at = 桶末 `2026-01-02T00:00:00Z`（±1s 容差）。
// 12 个度量值本身**不参与对拍**（期望侧 stats 不回填 yield 字段，见文件末"已知缺口"）。
//
// ── 用例为什么这么构造 ────────────────────────────────────────────────────────
//   hit = 注入 ≥1 条 bid → 全局桶存在 → 收口输出 1 行。
//   near_miss / miss = **构造不出来**：
//     · 没有"不命中的 bid"（任何 bid 都进同一个全局桶）；
//     · 没有阈值/排序 —— 12 个度量只改"值"，不改"是否输出"；
//     · 实体是常量，逐实体也无法构造差异（与 q1/q10 同族，只有 hit 有意义）。
//
// ── 注意事项（stats 桶的收口时机 / entity 口径 / 断言覆盖）──────────────────────
//   · **收口时机**：1d 固定桶在**流末收口**（batch / shutdown flush）输出，不是事件越界
//     触发 —— 1m 场景全部事件落在同一个 1d 桶里，桶在场景末尾收口。所以 `#[duration=1m]`
//     **不是**切分敏感量（只要 < 1d 就仍是单桶）；钉 1m 只为缩短运行时间。
//   · **背景噪声不干扰二元结论**：空键全局桶下背景只改度量值、不改行数（恒 1 行）。
//   · **INJ1 对本查询是空转（已如实记录，不是通过）**：实体是常量 1，`InjectEntities::
//     record_entity` 要求实体标识是 `entity(...)` 的**单字段**——常量实体计 `unasserted`
//     （`gen` 会打 `Warning: 1 inject entities skipped…`），`Inject assert:` 行不出现。
//     本语料的引擎级证据来自 L3（期望 ↔ 引擎两侧独立算出**同一行**的 entity_id/origin/
//     fired_at/计数），而不是 L1 的逐实体断言。要补 L1，需让 `entity(...)` 是字段实体
//     （如 q17/q19）——这是常量实体规则的固有边界。
//
// 用法：
//   wfgen lint scenarios/q15_verify.wfg
//   wfgen gen  --scenario scenarios/q15_verify.wfg --out /tmp/q15_gen
//   ./verify_wfg.sh q15        # L0/L0'/L1/L2 + L3 引擎级对拍（默认开）

use "../models/schemas/nexmark.wfs"
use "../models/queries/q15.wfl"

#[duration=1m]
scenario q15_verify<seed=1> {
  background {
    // 空键全局桶：背景只改 12 个度量值，不改输出行数（恒 1 行）；速率只影响度量规模
    stream bid_events gen 200/s
  }

  inject {
    // 命中：1 条 bid 进全局桶（price=5000 → r1 价格档）→ 1d 收口输出 1 行。
    // 实体是常量，逐实体条数没有意义，1 个实体即可。
    hit<1> for q15_bidding_stats bid_events {
      use(price=5000) x 1
    }
  }
}
