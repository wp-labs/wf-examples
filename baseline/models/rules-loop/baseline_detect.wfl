use "../schemas/metrics.wfs"
use "../schemas/baseline_ref.wfs"

// 基线偏离判定（全局周期基线供给通道，S2-M3a 最小验证 → 2026-09-08 相位化）。
// 每事件 join provider 静态表 baseline_ref（knowdb CSV 重载 / PG 直聚合），
// 取该 (entity, 同相位桶) 的历史同期基线（mu/sigma；数据契约保留可加三元组，
// 见 §11.3）——忙时只与忙时历史比（与近端 B 相位同窗同口径，B 精确 / A 近似）。
// 偏离超过 5× 的越界事件才产出告警。
// 形态对齐 q13b（on each + provider snapshot join）+ q3（join 后 where 过滤）：
// join miss（实体无供给 / 相位桶无行）→ ref 字段为空 → where 为 false → 不告警；
// 命中且越界 → 告警。
rule baseline_detect {
    events { e : metrics_stream }
    on each e -> score(80.0)
    join baseline_ref snapshot on e.entity == baseline_ref.entity && e.phase_bucket == baseline_ref.phase_bucket
    where (e.value - baseline_ref.mu) / baseline_ref.mu > 5.0
    entity(str, e.entity)
    yield baseline_alerts (
        entity    = e.entity,
        alert_type = "flow_deviation",
        value     = e.value,
        mu        = baseline_ref.mu,
        deviation = (e.value - baseline_ref.mu) / baseline_ref.mu
    )
}
