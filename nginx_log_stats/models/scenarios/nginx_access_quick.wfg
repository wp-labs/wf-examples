use "../schemas/nginx.wfs"
use "../rules/02-alert/nginx_5xx_surge.wfl"

// nginx_access_quick — 模拟 2 分钟 Nginx access 流量:
//   - hit: 300 个 client_ip 各 4 条 500（触发 http_5xx_surge，也计入 5xx 统计）
//   - miss: 10800 个 client_ip 各 1 条 200
// 统计规则 nginx_status_stats 对全部事件按 http_status 分组输出（无需 expect）。
// 旧 `hit<10%>` / `miss<90%>`（100/s × 2m = 12000 配额）按 wfg-design §5.2 折算：
//   实体数 = floor(round(配额 × pct/100) ÷ ΣN)
#[duration=2m]
scenario nginx_access_quick<seed=42> {
  background {
    stream nginx_access gen 100/s
  }
  inject {
    hit<300> for nginx_5xx_surge nginx_access {
      use(http_status="500") x 4
    }
    miss<10800> for nginx_5xx_surge nginx_access {
      use(http_status="200") x 1
    }
  }
}
